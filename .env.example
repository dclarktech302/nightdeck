# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# AWS S3
AWS_ACCESS_KEY_ID=your_new_iam_key
AWS_SECRET_ACCESS_KEY=your_new_iam_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=nightdeck-media
AWS_S3_PUBLIC_URL=https://nightdeck-media.s3.us-east-1.amazonaws.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Supabase service role — server only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key